---
Name: Zitadel Auth Provider
Type: daemon
Metadata: {"envVars": [{"name": "ZITADEL_CLIENT_ID", "friendlyName": "Client ID", "description": "OAuth2 Client ID from your Zitadel project"}, {"name": "ZITADEL_CLIENT_SECRET", "friendlyName": "Client Secret", "description": "OAuth2 Client Secret from your Zitadel project", "sensitive": true}, {"name": "ZITADEL_ISSUER_URL", "friendlyName": "Issuer URL", "description": "Your Zitadel instance URL, e.g. https://your-instance.zitadel.cloud"}], "optionalEnvVars": [{"name": "ZITADEL_SCOPES", "friendlyName": "Scopes", "description": "Comma-separated list of OAuth2 scopes (default: openid,profile,email)"}]}

#!/bin/bash
exec /bin/obot oidc-provider
